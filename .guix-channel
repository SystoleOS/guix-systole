(channel
 (version 0)
 (directory "systole")
 (news-file "etc/news.scm")
 (dependencies
  ;; Dependencies are pinned by commit so that pulling this channel
  ;; cannot silently change meaning when a dependency's branch moves;
  ;; bump the pins together with channels-lock.scm.
  (channel
   (name nonguix)
   (url "https://gitlab.com/nonguix/nonguix")
   (branch "master")
   (commit "accdba77be815bbe00868145dd66d68056eecf7a"))
  (channel
   (name systole-artwork)
   (url "https://github.com/systoleos/guix-systole-artwork")
   (branch "main")
   (commit "26e4f71bf518a03c646d42d7c65ec8529f3c63a6"))))
