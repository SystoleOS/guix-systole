;; Example 'guix deploy' deployment for a SystoleOS target.
;;
;; Normally you do not write this file by hand:
;;   ./scripts/prepare-deployment.sh --key <deploy-key> --host <ip> [--port N]
;; fetches the target's own /etc/config.scm and generates a deployment.scm
;; next to it.  This example documents the expected shape for manual setups.
;;
;; Replace every <...> placeholder before use.  Never commit private keys
;; or a deployment.scm containing real host data; the repository ignores
;; deployment.scm at the top level for that reason.

(use-modules (gnu)
             (gnu machine)
             (gnu machine ssh)
             (systole transformations)
             (nongnu system linux-initrd))

(define target-os
  ;; Either load the config generated by the installer on the target:
  ;;   (load "<path/to/target-config.scm>")
  ;; or construct one inline and wrap it with the systole transformations:
  ((compose (systole-transformation-guix
             #:guix-source? #t
             ;; Opt in only if you want the community guix.moe substitutes;
             ;; see systole-transformation-guix's docstring.
             #:community-substitutes? #f)
            (systole-transformation-linux #:initrd base-initrd))
   (operating-system
     (host-name "<host-name>")
     (timezone "Europe/Oslo")
     (locale "en_US.utf8")
     (keyboard-layout (keyboard-layout "us"))
     (bootloader (bootloader-configuration
                  (bootloader grub-bootloader)
                  (targets (list "<//dev/sda or /dev/vda>"))
                  (keyboard-layout keyboard-layout)))
     (file-systems (cons* (file-system
                            (mount-point "/")
                            (device (uuid "<root-fs-uuid>" 'ext4))
                            (type "ext4"))
                          %base-file-systems))
     (users (cons* (user-account
                    (name "<user>")
                    (group "users")
                    (supplementary-groups '("wheel" "netdev" "audio" "video")))
                   %base-user-accounts))
     (services
      (cons* (service openssh-service-type
                      (openssh-configuration
                       (permit-root-login 'prohibit-password)
                       (password-authentication? #f)
                       (authorized-keys
                        `(("root" ,(local-file "<deploy-key.pub>"))))))
             %base-services)))))

(list (machine
       (operating-system target-os)
       (environment managed-host-environment-type)
       (configuration (machine-ssh-configuration
                       (host-name "<target-ip-or-hostname>")
                       (system "x86_64-linux")
                       (port 22)
                       (user "root")
                       (identity "<path/to/deploy-key>")))))
