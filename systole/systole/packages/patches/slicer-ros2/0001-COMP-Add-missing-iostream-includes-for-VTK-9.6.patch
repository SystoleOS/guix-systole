diff --git a/MRML/vtkROS2ToSlicer.cxx b/MRML/vtkROS2ToSlicer.cxx
index 03ec141..fce28d2 100644
--- a/MRML/vtkROS2ToSlicer.cxx
+++ b/MRML/vtkROS2ToSlicer.cxx
@@ -1,3 +1,4 @@
+#include <iostream>
 #include <vtkROS2ToSlicer.h>
 #include <vtkMath.h>
 #include <vtkVariant.h>
