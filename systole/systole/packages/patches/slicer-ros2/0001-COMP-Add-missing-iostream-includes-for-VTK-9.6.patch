From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SystoleOS <systole@example.org>
Date: Fri, 27 Nov 2026 16:30:00 +0100
Subject: [PATCH] COMP: Add missing <iostream> includes for VTK 9.6

VTK 9.6 headers no longer include <iostream> transitively, nor provide
the global using-declarations for cout/cerr/clog, so code written
against older VTK fails with "'cerr' is not a member of 'std'" or
"'cerr' was not declared in this scope".  Include <iostream> in every
source file that uses these streams and qualify bare uses with std::.
---
 Logic/vtkSlicerROS2Logic.cxx             | 1 +
 MRML/vtkMRMLROS2ParameterInternals.h     | 1 +
 MRML/vtkMRMLROS2RobotNode.cxx            | 1 +
 MRML/vtkMRMLROS2ServiceClientInternals.h | 1 +
 MRML/vtkMRMLROS2Utils.cxx                | 1 +
 MRML/vtkROS2ToSlicer.cxx                 | 1 +
 6 files changed, 6 insertions(+)

diff --git a/Logic/vtkSlicerROS2Logic.cxx b/Logic/vtkSlicerROS2Logic.cxx
index c35a48e..c4af60a 100644
--- a/Logic/vtkSlicerROS2Logic.cxx
+++ b/Logic/vtkSlicerROS2Logic.cxx
@@ -1,3 +1,4 @@
+#include <iostream>
 /*==============================================================================
 
   Program: 3D Slicer
diff --git a/MRML/vtkMRMLROS2ParameterInternals.h b/MRML/vtkMRMLROS2ParameterInternals.h
index 4c968fd..2d98851 100644
--- a/MRML/vtkMRMLROS2ParameterInternals.h
+++ b/MRML/vtkMRMLROS2ParameterInternals.h
@@ -1,3 +1,4 @@
+#include <iostream>
 #ifndef __vtkMRMLROS2ParameterInternals_h
 #define __vtkMRMLROS2ParameterInternals_h
 
diff --git a/MRML/vtkMRMLROS2RobotNode.cxx b/MRML/vtkMRMLROS2RobotNode.cxx
index ac6e7d3..ca99c90 100644
--- a/MRML/vtkMRMLROS2RobotNode.cxx
+++ b/MRML/vtkMRMLROS2RobotNode.cxx
@@ -1,3 +1,4 @@
+#include <iostream>
 #include <vtkMRMLROS2RobotNode.h>
 
 #include <vtkEventBroker.h>
diff --git a/MRML/vtkMRMLROS2ServiceClientInternals.h b/MRML/vtkMRMLROS2ServiceClientInternals.h
index a6867e4..986b3b7 100644
--- a/MRML/vtkMRMLROS2ServiceClientInternals.h
+++ b/MRML/vtkMRMLROS2ServiceClientInternals.h
@@ -1,3 +1,4 @@
+#include <iostream>
 #ifndef __vtkMRMLROS2ServiceClientInternals_h
 #define __vtkMRMLROS2ServiceClientInternals_h
 
diff --git a/MRML/vtkMRMLROS2Utils.cxx b/MRML/vtkMRMLROS2Utils.cxx
index b7e33b5..21b289b 100644
--- a/MRML/vtkMRMLROS2Utils.cxx
+++ b/MRML/vtkMRMLROS2Utils.cxx
@@ -1,3 +1,4 @@
+#include <iostream>
 #include <vtkMRMLROS2Utils.h>
 
