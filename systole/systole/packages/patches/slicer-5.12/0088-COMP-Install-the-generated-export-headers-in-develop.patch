From 29bc6c8af795df647854fd5d085adf873d1b60b9 Mon Sep 17 00:00:00 2001
From: Rafael Palomar <rafael.palomar@ous-research.no>
Date: Thu, 23 Jul 2026 12:22:13 +0200
Subject: [PATCH] COMP: Install the generated export headers in development
 installs

Slicer 5.12 switched seven libraries (Base/CLI, Base/Logic,
Libs/MRML/{CLI,IDImageIO,Logic}, Libs/RemoteIO, Libs/vtkTeem) from
checked-in export headers to GenerateExportHeader output in the build
tree, but left the old ${configure_header_file} variable -- never set
anymore -- in their development install(FILES) lines.  The item
degenerates to the bare binary dir and CMake fails with 'install FILES
given directory'; and simply dropping it instead leaves the generated
*Export.h out of the installed tree, breaking every downstream
standalone module build on '<lib>Export.h: No such file or directory'.

Install the correct generated header explicitly per library, which is
what upstream's half-finished migration evidently intended.
---
 Base/CLI/CMakeLists.txt            | 2 +-
 Base/Logic/CMakeLists.txt          | 2 +-
 Libs/MRML/CLI/CMakeLists.txt       | 2 +-
 Libs/MRML/IDImageIO/CMakeLists.txt | 2 +-
 Libs/MRML/Logic/CMakeLists.txt     | 2 +-
 Libs/RemoteIO/CMakeLists.txt       | 2 +-
 Libs/vtkTeem/CMakeLists.txt        | 2 +-
 7 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/Base/CLI/CMakeLists.txt b/Base/CLI/CMakeLists.txt
index 0bf3963c6f..0f9712b6f8 100644
--- a/Base/CLI/CMakeLists.txt
+++ b/Base/CLI/CMakeLists.txt
@@ -64,7 +64,7 @@ endif()
 if(NOT ${PROJECT_NAME}_INSTALL_NO_DEVELOPMENT)
   file(GLOB headers "${CMAKE_CURRENT_SOURCE_DIR}/*.h")
   install(
-    FILES ${headers} ${CMAKE_CURRENT_BINARY_DIR}/${configure_header_file}
+    FILES ${headers} ${CMAKE_CURRENT_BINARY_DIR}/vtkSlicerBaseCLIExport.h
     DESTINATION include/${PROJECT_NAME} COMPONENT Development)
 endif()
 
